# MẪU khoá / token — chép thành config/.env và điền. KHÔNG gửi file .env cho ai, không đưa lên Git.

# Nhanh.vn (Open API v3) — tạo app ở https://open.nhanh.vn, lấy token: python src/get_access_token.py
NHANH_APP_ID=
NHANH_SECRET_KEY=
NHANH_BUSINESS_ID=
NHANH_ACCESS_TOKEN=
NHANH_API_VERSION=3.0
NHANH_RETURN_LINK=
NHANH_TOKEN_EXPIRES_AT=

# Meta — app trên developers.facebook.com (phải ở chế độ Live để chạy QC carousel từ bài nhiều ảnh)
# token người dùng dài hạn có ads_management, ads_read, pages_read_engagement, pages_show_list, business_management:
# python src/get_fb_token.py
FB_APP_ID=
FB_APP_SECRET=
META_ACCESS_TOKEN=

# Telegram — tạo bot với @BotFather, thêm bot vào nhóm, lấy chat id (số âm của nhóm)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pancake — token API công khai của từng page (Pancake → Cài đặt → Công cụ → API), tên biến khớp pancake.pages
PANCAKE_TOKEN_PAGE1=
# Pancake POS (tuỳ chọn, cho "đã chốt nhưng chưa lên đơn")
PANCAKE_POS_API_KEY=
PANCAKE_POS_SHOP_ID=
